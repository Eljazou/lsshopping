rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  L&S Shopping — Firebase Storage security rules
//
//  Product images: publicly readable (the storefront displays them),
//  uploads/deletes only allowed for an authenticated (admin) user.
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024 // 5MB max
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}

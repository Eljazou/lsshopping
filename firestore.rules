rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  L&S Shopping — Firestore security rules
//
//  Storefront model:
//   • products  — publicly READABLE. Full writes (add/edit/delete) require
//                 an authenticated admin. Additionally, ANY client may
//                 *decrement* just the `stock` field — this is what lets
//                 checkout reduce inventory without an admin session; see
//                 isValidStockDecrement() below for the exact constraints.
//   • orders    — publicly CREATE-only (customers place COD orders),
//                 readable/updatable only by an authenticated admin user.
//
//  Admin accounts are created manually in the Firebase console
//  (Authentication > Users > Add user) — there is no public sign-up. Because
//  of that, ANY authenticated user is trusted as an admin here. Only give
//  the admin login (email/password) to people you trust.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Basic shape validation for an incoming order.
    function isValidOrder(o) {
      return o.keys().hasAll(['customerName', 'phone', 'address', 'city', 'items', 'total', 'status'])
        && o.customerName is string && o.customerName.size() > 0
        && o.phone is string && o.phone.size() >= 6
        && o.address is string && o.address.size() > 0
        && o.city is string && o.city.size() > 0
        && o.items is list && o.items.size() > 0
        && o.total is number && o.total >= 0
        && o.status == 'pending';
    }

    // Lets checkout (unauthenticated) reduce a product's stock without
    // touching anything else: only the `stock` field may change, it must
    // go down (never up), never below zero, and by a sane amount in one
    // write (guards against a single request zeroing out inventory).
    function isValidStockDecrement() {
      let before = resource.data.stock;
      let after = request.resource.data.stock;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && after is number
        && after >= 0
        && after < before
        && before - after <= 50;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidStockDecrement();
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update: if isAdmin();
      allow delete: if false; // orders are never deleted, only status-updated
    }
  }
}

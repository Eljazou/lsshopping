rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  L&S Shopping — Firestore security rules
//
//  Storefront model:
//   • products  — publicly READABLE. Full writes (add/edit/delete) require
//                 an authenticated admin. Additionally, any *signed-in*
//                 customer may *decrement* just the `stock` field — this is
//                 what lets checkout reduce inventory; see
//                 isValidStockDecrement() below for the exact constraints.
//   • customers — a signed-in customer's own profile (name/phone/address).
//                 Only they (or an admin) can read it; only they can write it.
//   • orders    — creating one now requires a signed-in customer account,
//                 and the order's customerId must match the caller (no
//                 placing orders as someone else). Reading one is limited to
//                 its own customer or an admin — this is what "logged in ->
//                 my orders / tracking" is built on.
//   • reviews   — publicly CREATE-only (status starts 'pending'); only
//                 'approved' reviews are publicly readable, everything else
//                 (including moderation) requires an authenticated admin.
//
//  Admin vs. customer: both use the same Firebase Auth, but only a UID
//  listed in /admins is trusted as an admin (see isAdmin()). Admin accounts
//  are created manually (Firebase console + a matching /admins/{uid} doc,
//  written only via the Admin SDK/console — never from a client). Customers
//  self-sign-up through the app and are never added to /admins, so a
//  customer account can never gain admin access no matter what.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Basic shape validation for an incoming order. customerId must be the
    // caller's own uid — enforced in the create rule below, not here, so
    // this stays reusable if an admin ever needs to author one too.
    function isValidOrder(o) {
      return o.keys().hasAll(['customerId', 'customerName', 'phone', 'address', 'city', 'items', 'total', 'status'])
        && o.customerId is string && o.customerId.size() > 0
        && o.customerName is string && o.customerName.size() > 0
        && o.phone is string && o.phone.size() >= 6
        && o.address is string && o.address.size() > 0
        && o.city is string && o.city.size() > 0
        && o.items is list && o.items.size() > 0
        && o.total is number && o.total >= 0
        && o.status == 'pending';
    }

    // Basic shape validation for a customer profile.
    function isValidCustomerProfile(c) {
      return c.keys().hasAll(['customerName', 'phone', 'address', 'city'])
        && c.customerName is string && c.customerName.size() > 0
        && c.phone is string && c.phone.size() >= 6
        && c.address is string
        && c.city is string;
    }

    // Lets a signed-in customer reduce a product's stock without touching
    // anything else: only the `stock` field may change, it must go down
    // (never up), never below zero, and by a sane amount in one write
    // (guards against a single request zeroing out inventory).
    function isValidStockDecrement() {
      let before = resource.data.stock;
      let after = request.resource.data.stock;
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && after is number
        && after >= 0
        && after < before
        && before - after <= 50;
    }

    // Basic shape validation for an incoming review.
    function isValidReview(r) {
      return r.keys().hasAll(['productId', 'customerName', 'rating', 'comment', 'status'])
        && r.productId is string && r.productId.size() > 0
        && r.customerName is string && r.customerName.size() > 0 && r.customerName.size() <= 60
        && r.rating is number && r.rating >= 1 && r.rating <= 5
        && r.comment is string && r.comment.size() <= 500
        && r.status == 'pending';
    }

    // A user may check ONLY their own admin flag (used by the app to tell
    // whether a signed-in account should see the admin UI). Never listable,
    // never writable from a client — admins are added via the Admin SDK.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /customers/{uid} {
      allow read, update: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidCustomerProfile(request.resource.data);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidStockDecrement();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && isValidOrder(request.resource.data);
      // `resource == null` covers checking whether an orderRef is already
      // taken before creating one (createOrder's collision check) — without
      // it, referencing resource.data on a nonexistent doc throws and the
      // whole read is denied, breaking that check for every signed-in user.
      allow get, list: if isAdmin()
        || resource == null
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false; // orders are never deleted, only status-updated
    }

    match /reviews/{reviewId} {
      allow create: if isValidReview(request.resource.data);
      allow get, list: if isAdmin() || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }
  }
}

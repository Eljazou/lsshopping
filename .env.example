# ─────────────────────────────────────────────────────────────
#  Éclat Cosmetics — Environment variables
#  Copy this file to `.env` and fill in your real values.
#  NOTE: This is a client-only app. Anything prefixed with VITE_
#  is bundled into the shipped JavaScript and is NOT secret.
#  The real access control lives in firestore.rules.
# ─────────────────────────────────────────────────────────────

# Toggle the mock data layer.
#   true  -> app runs entirely on in-memory mock data (no Firebase needed)
#   false -> app talks to real Firestore using the config below
VITE_USE_MOCK=true

# ── Firebase (from Firebase console > Project settings > Your apps) ──
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ── EmailJS (from https://dashboard.emailjs.com) ──
# Two separate templates: one email to you (the owner) per new order, and
# one to the customer at checkout + every status change. See README for the
# exact template variables each one needs.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_owner_template_id
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ── Store owner email shown on the confirmation / used as email target ──
VITE_STORE_OWNER_EMAIL=owner@example.com

# NOTE: The admin dashboard (/admin) always requires VITE_USE_MOCK=false.
# It uses Firebase Authentication (email/password) — there is no separate
# admin password env var. Create the admin account manually in the Firebase
# console: Authentication > Sign-in method > enable Email/Password, then
# Authentication > Users > Add user. See README for details.
